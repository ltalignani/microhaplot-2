# Copy this file to .env (next to docker-compose.yml) and adjust as needed.

# Image tag to run. Defaults to the latest published release.
MICROHAPLOT_VERSION=latest

# Host folder shared by both services; becomes the container user's $HOME,
# so ~/Shiny/microhaplot resolves to the same physical directory for both.
MICROHAPLOT_DATA_DIR=./microhaplot-data

# Host ports for each service.
MICROHAPLOT_MAIN_PORT=3838
MICROHAPLOT_PREP_PORT=3839

# UID/GID the containers run as, so the non-root container user can write
# to MICROHAPLOT_DATA_DIR on the host. Defaults match the first user on
# most Linux distros. Run `id -u` / `id -g` if yours differ.
MICROHAPLOT_UID=1000
MICROHAPLOT_GID=1000
